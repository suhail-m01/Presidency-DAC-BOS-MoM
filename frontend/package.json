{
  "name": "dac-minutes-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "ui:smoke": "node tests/ui_smoke.mjs",
    "css:check": "node tests/css_integrity.mjs",
    "check": "npm run build && npm run css:check && npm run ui:smoke",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^29.1.1"
  }
}
