# DAC-MOM - application configuration
# Copy this file to ".env" and edit. Real environment variables always win over
# this file. Restart the server after any change.
#
# Nothing here is required to start the application: without a mail server the
# sign-in code is printed in the server console and written to
# data/mail-outbox/, and content verification falls back to the offline rules.

# ----------------------------------------------------------------- environment
# development (default) | production
# In production: the sign-in code is never echoed to the browser, the test clock
# hooks are disabled, and FLASK_SECRET_KEY must be set.
APP_ENV=development

# A long random string. Required when APP_ENV=production.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Development only: return the sign-in code to the browser so automated tests can
# sign in. Ignored (always off) when APP_ENV=production.
DEV_ECHO_OTP=1

# Test-only clock hooks (/api/testing/*). Always off when APP_ENV=production.
DAC_TEST_HOOKS=1

# ------------------------------------------------------------------ sign-in mail
# MAIL_TRANSPORT: file (default, writes .eml into data/mail-outbox) | smtp | graph
MAIL_TRANSPORT=file
MAIL_DOMAIN=college.example

# Option A - a college SMTP relay (the quickest way to email sign-in codes)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=minutes@college.example
# SMTP_PASSWORD=...
# SMTP_FROM=minutes@college.example
# SMTP_STARTTLS=1

# Option B - Microsoft 365 through Graph (send-as the person who acted)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=minutes@college.example

# -------------------------------------------------------- OAuth SSO providers
# Google OAuth 2.0 (Google Cloud Console credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Azure AD OAuth 2.0
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ------------------------------------------------------- content verification
# Works with no key: the offline rules always run. Add ONE provider to use a model.
# Option 1 - OpenAI or any OpenAI-compatible gateway:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
#
# Option 2 - Azure OpenAI:
# AI_PROVIDER=azure
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
#
# Option 3 - Google Gemini:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-flash-latest
#
# Shared AI options:
# AI_TIMEOUT=45
# AI_MAX_ITEMS=12
# AI_ALLOW_CONTENT_UPLOAD=1
